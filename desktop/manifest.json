{
  "manifest_version": 3,
  "name": "Royal — desktop experiment",
  "version": "0.5.4",
  "description": "Royal's feeds with your desktop Reddit and YouTube logins, plus a private CloudKit sync probe. Does not sync feeds yet.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://api.apple-cloudkit.com/*",
    "https://www.reddit.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Open Royal"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.apple-cloudkit.com https://www.reddit.com https://hacker-news.firebaseio.com https://www.youtube.com"
  }
}
