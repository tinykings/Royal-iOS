{
  "manifest_version": 3,
  "name": "Royal — iCloud sync experiment",
  "version": "0.1.0",
  "description": "Test Royal's private CloudKit sign-in and cross-device records. Does not sync feeds yet.",
  "minimum_chrome_version": "120",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://api.apple-cloudkit.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Open Royal sync experiment" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.apple-cloudkit.com"
  }
}
